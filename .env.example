# LOFTER 下载器配置
# 复制此文件为 .env 并按需修改

# 下载存储根目录
LOFTER_DOWNLOAD_DIR=~/lofter_downloads

# HTTP 请求间隔（秒），防止被封
LOFTER_REQUEST_INTERVAL=1.5

# 最大重试次数
LOFTER_MAX_RETRIES=3

# 请求超时（秒）
LOFTER_REQUEST_TIMEOUT=30

# 日志级别: DEBUG / INFO / WARNING / ERROR
LOFTER_LOG_LEVEL=INFO

# 最大并发请求数
LOFTER_MAX_CONCURRENCY=3

# 数据库路径
LOFTER_DB_PATH=~/.lofter_downloader/data.db

# 手机端 API 认证 Token（lofter-phone-login-auth）
# 从浏览器登录 LOFTER 后，F12 → 任意 api.lofter.com 请求头中复制
LOFTER_LOFTER_PHONE_LOGIN_AUTH=
